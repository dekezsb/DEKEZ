{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/dekez-chat-assistant",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/dekez-chat-reminders",
      "schedule": "7,17,27,37,47,57 * * * *"
    },
    {
      "path": "/api/rental-billing",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/rent-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/tenancy-renewals",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/document-archive",
      "schedule": "*/10 * * * *"
    }
  ]
}
