{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/rental-billing",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/rent-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/tenancy-renewals",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/document-archive",
      "schedule": "*/10 * * * *"
    }
  ]
}
